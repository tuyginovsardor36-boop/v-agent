# Environment
NODE_ENV=development

# v0 API (optional)
# Keep empty for strict BYOK mode. Each signed-in user adds their own key in-app.
# V0_API_KEY=

# Optional: Custom v0 API URL (leave empty for default)
V0_API_URL=

# Local two-agent workspace
# Important: write the real key value (gsk_...), not process.env.GROQ_API_KEY_2
GROQ_API_KEY=
# Optional fallback if your key is stored under the v0-provided second name
GROQ_API_KEY_2=
GROQ_MODEL=llama-3.3-70b-versatile
# Absolute folder where Builder/Debugger may read, write, and run allowlisted commands
AGENT_WORKSPACE_ROOT=
